<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Notchly finds nearby players on your network so you can invite them to a chess game.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_notchly-chess._tcp</string>
		<string>_notchly-chess._udp</string>
		<string>_notchly-poker._tcp</string>
		<string>_notchly-poker._udp</string>
	</array>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Add to Notchly Shelf</string>
			</dict>
			<key>NSMessage</key>
			<string>addToShelf</string>
			<key>NSPortName</key>
			<string>Notchly</string>
			<key>NSSendTypes</key>
			<array>
				<string>public.file-url</string>
				<string>NSFilenamesPboardType</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
